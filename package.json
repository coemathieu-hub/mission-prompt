{
  "name": "mission-prompt",
  "version": "0.1.0",
  "description": "Transforme des idées dictées ou tapées en prompt structuré pour Claude Code",
  "scripts": {
    "mockup": "node scripts/build-mockup.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "dev": "vite",
    "build:pwa": "vite build --mode pwa",
    "build:single": "vite build --mode single && node scripts/rename-single.mjs",
    "build:app": "vite build --mode app && cap sync android",
    "build": "npm run build:pwa && npm run build:single",
    "preview": "vite preview --outDir dist/pwa",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@playwright/test": "^1.56.1",
    "fake-indexeddb": "^6.2.6",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "xlsx": "^0.18.5"
  }
}
